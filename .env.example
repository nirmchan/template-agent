# Agent Server Configuration (custom FastAPI mode)
AGENT_HOST=0.0.0.0
AGENT_PORT=5002

# Logging
# LOG_FORMAT: "json" (default, production) or "console" (dev-friendly with colors)
# SERVICE_NAME: appears in every log line (default: template-agent)
LOG_FORMAT=json
# SERVICE_NAME=template-agent

# Aegra Configuration
# Used by `aegra dev` and `aegra serve`

# SSO / OIDC Authentication
# Supports any OIDC-compliant provider (Keycloak, Okta, Azure AD, Auth0, etc.)
ENABLE_AUTH=false
SSO_ISSUER_URL=https://sso.example.com/realms/myrealm
SSO_CLIENT_ID=your-client-id
SSO_CLIENT_SECRET=your-client-secret
# SSO_JWKS_URI=https://sso.example.com/realms/myrealm/protocol/openid-connect/certs

# Dev fallback identity (used when ENABLE_AUTH=false)
SSO_DEV_USERNAME=John Doe
SSO_DEV_USER_ID=dev-user

# User ID encryption for observability privacy
ENABLE_USER_ID_ENCRYPTION=false
# USER_ID_ENCRYPTION_KEY=your-32-byte-hex-key

# ==============================================================================
# Development Stack Services (for `make dev`)
# ==============================================================================

# Redis - Aegra broker (SSE streaming, crash recovery, horizontal scaling)
REDIS_URL=redis://redis:6379/0
REDIS_BROKER_ENABLED=true

# Langfuse - LLM observability
# For local dev stack (`make dev`), use the self-hosted instance:
#   LANGFUSE_PUBLIC_KEY=pk-lf-dev
#   LANGFUSE_SECRET_KEY=sk-lf-dev
#   LANGFUSE_BASE_URL=http://langfuse:3000
# For production / cloud, see the Langfuse section below.

# OpenTelemetry - Distributed tracing
OTEL_ENABLED=true
OTEL_SERVICE_NAME=template-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# ==============================================================================
# Caching (all layers disabled by default)
# ==============================================================================

# Master switch — must be true for any cache layer to activate
CACHE_ENABLED=false

# LLM model instance cache (in-memory, avoids re-creating clients per request)
CACHE_MODEL_ENABLED=false
# CACHE_MODEL_TTL=600
# CACHE_MODEL_MAX_SIZE=10

# User personalization cache (Redis L2, avoids Postgres per request)
CACHE_PERSONALIZATION_ENABLED=false
# CACHE_PERSONALIZATION_TTL=120

# Cache observability (logs hit/miss counters periodically)
CACHE_METRICS_ENABLED=false

# Pre-create models at startup (removes cold-start penalty)
CACHE_WARMING_ENABLED=false

# Use Redis as shared L2 cache layer (for personalization)
CACHE_REDIS_ENABLED=false

# ==============================================================================
# Memory Management (background processing, all disabled by default)
# ==============================================================================

# Master switch — enables background memory consolidation jobs
MEMORY_CONSOLIDATION_ENABLED=false

# Individual memory processing layers
MEMORY_DECAY_ENABLED=false
MEMORY_CLUSTERING_ENABLED=false
MEMORY_RELATIONSHIPS_ENABLED=false

# Tuning
# MEMORY_SCHEDULER_INTERVAL_HOURS=6
# MEMORY_MAX_INJECT=20
# MEMORY_DECAY_LAMBDA=0.05
# MEMORY_CLUSTER_THRESHOLD=0.4
# MEMORY_CONSOLIDATION_MIN_CLUSTER=3

# ==============================================================================
# Production / Aegra Worker Pool
# ==============================================================================

# Aegra Worker Pool (uncomment for production)
# AEGRA_NUM_WORKERS=4
# AEGRA_MAX_CONCURRENT=10
# AEGRA_TASK_TIMEOUT=300

# Optional: SSL/TLS configuration (comment out if not using HTTPS)
AGENT_SSL_KEYFILE=/path_to/ssl_key.pem
AGENT_SSL_CERTFILE=/path_to/ssl_cert.pem

# Request logging (logs every incoming request)
REQUEST_LOGGING_ENABLED=true

# Python Logging
PYTHON_LOG_LEVEL=INFO

# pgvector credentials for agentic memory
POSTGRES_USER=pgvector
POSTGRES_PASSWORD=pgvector
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_DB=pgvector

# Langfuse Configuration (v4 SDK — auto-read by client and CallbackHandler)
# Get keys from Langfuse UI → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Google Vertex AI service creds
GOOGLE_APPLICATION_CREDENTIALS_CONTENT='{
    "type": "service_account",
    "project_id": "data-and-ai-gemini",
    ...
    ...
    ...
    "universe_domain": "googleapis.com"
  }'
