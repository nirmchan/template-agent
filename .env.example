# Agent Server Configuration (custom FastAPI mode)
AGENT_HOST=0.0.0.0
AGENT_PORT=5002

# Aegra / LangGraph Platform Configuration
# Used by `langgraph dev` and `langgraph up` (not the custom FastAPI server)
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGGRAPH_AUTH_TYPE=noop
# LANGGRAPH_API_KEY=your-api-key-here
# LANGGRAPH_JWT_SECRET=your-jwt-secret-here

# Redis (optional — agent works without it, caching disabled)
# REDIS_URL=redis://localhost:6379/0
# REDIS_MAX_CONNECTIONS=10

# OpenTelemetry (optional)
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=template-agent-aegra
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Aegra Worker Pool
# AEGRA_NUM_WORKERS=4
# AEGRA_MAX_CONCURRENT=10
# AEGRA_TASK_TIMEOUT=300

# Optional: SSL/TLS configuration (comment out if not using HTTPS)
AGENT_SSL_KEYFILE=/path_to/ssl_key.pem
AGENT_SSL_CERTFILE=/path_to/ssl_cert.pem

# Python Logging
PYTHON_LOG_LEVEL=INFO

# pgvector credentials for agentic memory
POSTGRES_USER=pgvector
POSTGRES_PASSWORD=pgvector
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_DB=pgvector

# Langfuse Configuration (4.x)
LANGFUSE_SECRET_KEY=langfuse-secret-key
LANGFUSE_PUBLIC_KEY=langfus-public-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Langfuse 4.x uses LANGFUSE_TRACING_ENVIRONMENT env var (auto-read by client and handler)
LANGFUSE_TRACING_ENVIRONMENT=development

#Google Vertex AI service creds
GOOGLE_APPLICATION_CREDENTIALS_CONTENT='{
    "type": "service_account",
    "project_id": "data-and-ai-gemini",
    ...
    ...
    ...
    "universe_domain": "googleapis.com"
  }'
